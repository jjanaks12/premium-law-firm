// Auth module Prisma schema
// Colocated with auth module — collected into prisma/schema/ at build time

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  first_name String
  last_name  String
  password   String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  detail     Json?     @default("{}")

  avatar_id String?
  avatar    Resource? @relation("user_avatar", fields: [avatar_id], references: [id])
  role_id   String?
  role      Role?     @relation(fields: [role_id], references: [id])

  @@map("users")
}

model Resource {
  id         String    @id @default(uuid())
  url        String
  type       String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  users User[] @relation("user_avatar")

  @@map("resources")
}

// Base Prisma configuration — datasource and generator
// This file must exist in the schema directory for Prisma to function.
// Individual module schemas (e.g. auth.prisma) are collected here at build time.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../../prisma/generated/client"
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  permissions Json?
  users       User[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("roles")
}
