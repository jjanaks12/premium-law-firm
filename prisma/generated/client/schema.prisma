// Auth module Prisma schema
// Colocated with auth module — collected into prisma/schema/ at build time

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  first_name            String
  last_name             String
  password              String?
  status                String    @default("active")
  invitation_token      String?   @unique
  invitation_expires_at DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  deleted_at            DateTime?
  detail                Json?     @default("{}")

  avatar_id          String?
  avatar             Resource?            @relation("user_avatar", fields: [avatar_id], references: [id])
  role_id            String?
  role               Role?                @relation(fields: [role_id], references: [id])
  notifications      Notification[]
  refresh_tokens     RefreshToken[]
  reset_tokens       PasswordResetToken[]
  pages              Page[]               @relation("page_author")
  cases_as_lawyer    CaseLawyer[]
  cases_as_pleader   CasePleading[]
  cases_as_counselor CaseCounseling[]
  cases_created      Case[]               @relation("CaseCreatedBy")

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("password_reset_tokens")
}

model Resource {
  id         String    @id @default(uuid())
  url        String
  type       String
  name       String?
  size       Int?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  users              User[]    @relation("user_avatar")
  page_thumbnails    Page[]    @relation("page_thumbnail")
  page_seo_og_images PageSeo[] @relation("page_seo_og_image")

  @@map("resources")
}

// Base Prisma configuration — datasource and generator
// This file must exist in the schema directory for Prisma to function.
// Individual module schemas (e.g. auth.prisma) are collected here at build time.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../../prisma/generated/client"
}

model CourtLevel {
  id          String            @id @default(uuid())
  name        String            @unique
  nepaliName  String?
  proceedings CourtProceeding[]

  @@map("court_levels")
}

model CaseNature {
  id         String  @id @default(uuid())
  name       String  @unique
  nepaliName String?
  cases      Case[]

  @@map("case_natures")
}

model PartyRole {
  id         String      @id @default(uuid())
  name       String      @unique
  nepaliName String?
  parties    CaseParty[]

  @@map("party_roles")
}

// CORE MODELS

model Case {
  id                 String     @id @default(uuid())
  caseNumber         String     @unique
  caseName           String
  natureId           String
  nature             CaseNature @relation(fields: [natureId], references: [id])
  registrationDate   DateTime?
  registrationFee    Decimal?
  sectionCourtRoom   String?
  facts              String?    @db.Text
  relatedLaws        String?    @db.Text
  referredThrough    String?
  noticeStatus       String?
  fullJudgmentDate   DateTime?
  judgmentVerifyDate DateTime?
  status             String     @default("Draft")

  createdById String?
  createdBy   User?   @relation("CaseCreatedBy", fields: [createdById], references: [id])

  // Relations
  lawyers     CaseLawyer[] // Joined to User via CaseLawyer
  parties     CaseParty[]
  hearings    CaseHearing[]
  pleadings   CasePleading[]
  proceedings CourtProceeding[]
  precedents  CasePrecedent[]
  payments    CasePayment[]
  counselings CaseCounseling[]
  documents   CaseDocument[]

  createdAt DateTime @default(now())

  @@map("cases")
}

model CaseLawyer {
  caseId String
  userId String
  isLead Boolean @default(false)
  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([caseId, userId])
  @@map("case_lawyers")
}

model CaseParty {
  id               String      @id @default(uuid())
  caseId           String
  case             Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  partyName        String
  roleId           String
  role             PartyRole   @relation(fields: [roleId], references: [id])
  fee              Decimal?
  citizenshipNo    String?
  permanentAddress String?
  temporaryAddress String?
  contactNo        String?
  parentId         String?
  parent           CaseParty?  @relation("PartyToWaris", fields: [parentId], references: [id], onDelete: Cascade)
  waris            CaseParty[] @relation("PartyToWaris")

  @@map("case_parties")
}

model CaseHearing {
  id              String    @id @default(uuid())
  caseId          String
  case            Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  nextHearingDate DateTime?
  hearingDate     DateTime?
  hearingOrder    String?   @db.Text
  judgeName       String?

  @@map("case_hearings")
}

model CasePleading {
  id            String    @id @default(uuid())
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  pleaderUserId String?
  pleader       User?     @relation(fields: [pleaderUserId], references: [id], onDelete: SetNull)
  pleadingDate  DateTime?
  pleadingNotes String    @db.Text

  @@map("case_pleadings")
}

model CourtProceeding {
  id               String     @id @default(uuid())
  caseId           String
  case             Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  courtLevelId     String
  courtLevel       CourtLevel @relation(fields: [courtLevelId], references: [id])
  courtName        String
  judgeName        String?
  chargeCounseling String?    @db.Text
  verdict          String?    @db.Text

  @@map("court_proceedings")
}

model CasePrecedent {
  id             String  @id @default(uuid())
  caseId         String
  case           Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  decisionNumber String?
  plaintiff      String?
  defendant      String?
  citationNotes  String? @db.Text

  @@map("case_precedents")
}

model CasePayment {
  id          String    @id @default(uuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  amount      Decimal
  paymentDate DateTime?
  method      String?
  referenceNo String?
  notes       String?   @db.Text

  createdAt DateTime @default(now())

  @@map("case_payments")
}

model CaseCounseling {
  id              String    @id @default(uuid())
  caseId          String
  case            Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  counselorUserId String?
  counselor       User?     @relation(fields: [counselorUserId], references: [id], onDelete: SetNull)
  date            DateTime?
  notes           String    @db.Text

  createdAt DateTime @default(now())

  @@map("case_counselings")
}

model CaseDocument {
  id          String  @id @default(uuid())
  caseId      String
  case        Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName    String
  description String? @db.Text
  documentUrl String

  createdAt DateTime @default(now())

  @@map("case_documents")
}

// Notifications module Prisma schema
// Colocated with notifications module — collected into prisma/schema/ at build time

model Notification {
  id         String   @id @default(uuid())
  user_id    String?
  user       User?    @relation(fields: [user_id], references: [id])
  type       String // e.g., "EMAIL"
  recipient  String
  subject    String?
  content    String
  status     String // "SENT" or "FAILED"
  error      String?
  created_at DateTime @default(now())

  @@map("notifications")
}

// Pages module Prisma schema
// Colocated with pages module — collected into prisma/schema/ at build time

model PageType {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  pages Page[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("page_types")
}

model Page {
  id      String  @id @default(uuid())
  slug    String  @unique
  title   String
  content Json    @default("{}")
  excerpt String?
  status  String  @default("draft")
  locale  String  @default("en")

  parent_id String?
  parent    Page?   @relation("PageChildren", fields: [parent_id], references: [id])
  children  Page[]  @relation("PageChildren")

  page_type_id String?
  page_type    PageType? @relation(fields: [page_type_id], references: [id])

  thumbnail_id String?
  thumbnail    Resource? @relation("page_thumbnail", fields: [thumbnail_id], references: [id])

  author_id String?
  author    User?   @relation("page_author", fields: [author_id], references: [id])

  seo    PageSeo?
  schema PageSchema?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("pages")
}

model PageSeo {
  id      String @id @default(uuid())
  page_id String @unique
  page    Page   @relation(fields: [page_id], references: [id], onDelete: Cascade)

  meta_title       String?
  meta_description String?
  meta_keywords    String?
  og_title         String?
  og_description   String?
  og_image_id      String?
  og_image         Resource? @relation("page_seo_og_image", fields: [og_image_id], references: [id])
  canonical_url    String?
  robots           String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("page_seo")
}

model PageSchema {
  id      String @id @default(uuid())
  page_id String @unique
  page    Page   @relation(fields: [page_id], references: [id], onDelete: Cascade)

  schema_type String?
  schema_data Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("page_schemas")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  is_staff    Boolean @default(false)

  permissions Json?
  users       User[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("roles")
}
