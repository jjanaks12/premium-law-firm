model CourtLevel {
  id          String            @id @default(uuid())
  name        String            @unique
  nepaliName  String?

  @@map("court_levels")
}

model CaseNature {
  id         String  @id @default(uuid())
  name       String  @unique
  nepaliName String?
  cases      Case[]

  @@map("case_natures")
}

model PartyRole {
  id         String      @id @default(uuid())
  name       String      @unique
  nepaliName String?
  parties    CaseParty[]

  @@map("party_roles")
}

// CORE MODELS

model Case {
  id                     String                 @id @default(uuid())
  natureId               String
  nature                 CaseNature             @relation(fields: [natureId], references: [id])
  registrationFee        Decimal?
  facts                  String?                @db.Text
  details                Json?
  relatedLaw             Json?
  referredThrough        String?
  noticeStatus           String?
  fullJudgmentDate       DateTime?
  judgmentVerifyDate     DateTime?
  status                 String                 @default("Draft")

  createdById            String?
  createdBy              User?                  @relation("CaseCreatedBy", fields: [createdById], references: [id])

  // Relations
  courtDetails           CaseCourtDetail[]
  lawyers                CaseLawyer[]           // Joined to User via CaseLawyer
  parties                CaseParty[]
  hearings               CaseHearing[]
  payments               CasePayment[]
  documents              CaseDocument[]
  judgements             CaseJudgement[]

  createdAt              DateTime               @default(now())

  @@map("cases")
}

model CaseCourtDetail {
  id               String            @id @default(uuid())
  caseId           String
  case             Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseName         String
  caseNumber       String
  registrationDate DateTime?
  judgeName        String?
  courtType        String?
  courtName        String?
  sectionCourtRoom String?
  parentId         String?
  parent           CaseCourtDetail?  @relation("CourtDetailHistory", fields: [parentId], references: [id], onDelete: SetNull)
  children         CaseCourtDetail[] @relation("CourtDetailHistory")
  isActive         Boolean           @default(true)
  hearings         CaseHearing[]
  judgements       CaseJudgement[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("case_court_details")
}

model CaseLawyer {
  caseId   String
  userId   String
  isLead   Boolean @default(false)
  case     Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([caseId, userId])
  @@map("case_lawyers")
}

model CaseParty {
  id               String    @id @default(uuid())
  caseId           String
  case             Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  partyName        String
  roleId           String
  role             PartyRole @relation(fields: [roleId], references: [id])
  fee              Decimal?
  citizenshipNo    String?
  permanentAddress String?
  temporaryAddress String?
  contactNo        String?
  parentId         String?
  parent           CaseParty?  @relation("PartyToWaris", fields: [parentId], references: [id], onDelete: Cascade)
  waris            CaseParty[] @relation("PartyToWaris")

  @@map("case_parties")
}

model CaseHearing {
  id                String            @id @default(uuid())
  caseId            String
  case              Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseCourtDetailId String?
  caseCourtDetail   CaseCourtDetail?  @relation(fields: [caseCourtDetailId], references: [id], onDelete: SetNull)
  nextHearingDate   DateTime?
  hearingDate       DateTime?
  hearingOrder      String?           @db.Text

  @@map("case_hearings")
}

model CasePayment {
  id            String    @id @default(uuid())
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  amount        Decimal
  paymentDate   DateTime?
  method        String?
  referenceNo   String?
  notes         String?   @db.Text
  receivedByUserId String?
  receivedByUser   User?     @relation(fields: [receivedByUserId], references: [id], onDelete: SetNull)
  receivedBy    String?

  createdAt     DateTime  @default(now())

  @@map("case_payments")
}

model CaseDocument {
  id          String   @id @default(uuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName    String
  description String?  @db.Text
  documentUrl String

  createdAt   DateTime @default(now())

  @@map("case_documents")
}

model CaseJudgement {
  id                 String            @id @default(uuid())
  caseId             String
  case               Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseCourtDetailId  String
  caseCourtDetail    CaseCourtDetail   @relation(fields: [caseCourtDetailId], references: [id], onDelete: Cascade)
  type               String
  date               DateTime?
  verifiedDate       DateTime?
  detail             Json?
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("case_judgements")
}
